{{#if entries}}
<div class="eternia chat-card lh-combat-card lh-applied-card lh-applied-group{{#if undone}} undone{{/if}}">
	{{#each entries}}
	<div class="lh-applied-entry{{#if undone}} undone{{/if}}">
		<div class="lh-applied-title"><strong>{{name}}</strong> · {{skillName}} <span class="lh-applied">{{result}}</span></div>
		<ul class="lh-applied-lines">
			{{#each lines}}<li>{{this}}</li>{{/each}}
		</ul>
		{{#if undone}}
		<div class="lh-undone">{{localize 'ETERNIA.Combat.Undone'}}</div>
		{{else}}
		<div class="lh-applied-buttons">
			<button type="button" class="lh-undo" data-index="{{@index}}"><i class="fas fa-rotate-left"></i> {{localize 'ETERNIA.Combat.Undo'}}</button>
		</div>
		{{/if}}
	</div>
	{{/each}}
	{{#unless undone}}
	<div class="lh-applied-buttons">
		<button type="button" class="lh-undo"><i class="fas fa-rotate-left"></i> {{localize 'ETERNIA.Combat.UndoAll'}}</button>
		<button type="button" class="lh-reveal" data-tooltip="ETERNIA.Combat.Hint.reveal"><i class="fas fa-eye"></i> {{localize 'ETERNIA.Combat.Reveal'}}</button>
	</div>
	{{/unless}}
</div>
{{else}}
<div class="eternia chat-card lh-combat-card lh-applied-card{{#if undone}} undone{{/if}}">
	<div class="lh-applied-title"><strong>{{name}}</strong> · {{skillName}} <span class="lh-applied">{{result}}</span></div>
	<ul class="lh-applied-lines">
		{{#each lines}}<li>{{this}}</li>{{/each}}
	</ul>
	{{#if undone}}
	<div class="lh-undone">{{localize 'ETERNIA.Combat.Undone'}}</div>
	{{else}}
	<div class="lh-applied-buttons">
		<button type="button" class="lh-undo"><i class="fas fa-rotate-left"></i> {{localize 'ETERNIA.Combat.Undo'}}</button>
		<button type="button" class="lh-reveal" data-tooltip="ETERNIA.Combat.Hint.reveal"><i class="fas fa-eye"></i> {{localize 'ETERNIA.Combat.Reveal'}}</button>
	</div>
	{{/if}}
</div>
{{/if}}
