<div class="eternia chat-card lh-combat-card lh-attack-card">
	<header class="chat-card-header">
		<img class="chat-card-img" src="{{img}}" alt="{{skillName}}" />
		<div class="chat-card-title">
			<h3>{{skillName}}</h3>
			<span class="chat-card-type">{{#if auto}}{{localize 'ETERNIA.Combat.AutoHit'}}{{else}}{{localize 'ETERNIA.Combat.HitCheck'}} vs {{labels.vs}}{{/if}}{{#if range}} · {{range}}{{/if}}</span>
			{{#if weapon}}<span class="chat-card-weapon"><i class="fas fa-khanda"></i> {{weapon}}</span>{{/if}}
		</div>
	</header>

	{{#unless auto}}
	{{{rollHTML}}}
	{{#if bonuses}}<div class="lh-card-bonuses" data-tooltip="ETERNIA.RollFilter.CardBonuses"><i class="fas fa-circle-plus"></i> {{bonuses}}</div>{{/if}}
	{{#if attack.critical}}<div class="lh-outcome critical">{{localize 'ETERNIA.Combat.Critical'}}</div>{{/if}}
	{{#if attack.fumble}}<div class="lh-outcome fumble">{{localize 'ETERNIA.Combat.Fumble'}}</div>{{/if}}
	{{#if attack.notes.length}}<div class="lh-card-adjusted"><i class="fas fa-wand-sparkles"></i> {{localize 'ETERNIA.Combat.Adjusted' total=attack.total dice=attack.results}} · {{#each attack.notes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}
	{{/unless}}

	<ol class="lh-targets">
		{{#each targets as |target i|}}
		<li class="lh-target" data-index="{{i}}">
			<img class="lh-target-img" src="{{target.img}}" alt="{{target.name}}" />
			<span class="lh-target-name">{{target.name}}</span>
			{{#if (eq target.distance 0)}}<span class="lh-distance">{{localize 'ETERNIA.Combat.Close'}}</span>
			{{else if target.distance}}<span class="lh-distance">{{target.distance}} Sq</span>{{/if}}
			{{#if target.dodge}}
			<span class="lh-dodge" data-tooltip="{{target.dodge.formula}} [{{target.dodge.results}}]{{#if target.dodge.hateUnder}} · {{localize 'ETERNIA.Combat.HateUnder'}}{{/if}}{{#if target.dodge.conditions}} · {{target.dodge.conditions}}{{/if}}">
				{{#if target.dodge.critical}}<i class="fas fa-star"></i>{{/if}}{{#if target.dodge.fumble}}<i class="fas fa-skull"></i>{{/if}}
				{{target.dodge.total}}{{#if target.dodge.notes.length}} <i class="fas fa-wand-sparkles lh-adjusted-mark" data-tooltip="{{#each target.dodge.notes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}"></i>{{/if}}
			</span>
			{{else}}{{#unless target.auto}}
			<button type="button" class="lh-roll-dodge owner-only"><i class="fas fa-shield-halved"></i> {{localize 'ETERNIA.Combat.Dodge'}}</button>
			{{/unless}}{{/if}}
			{{#if (eq target.hit true)}}<span class="lh-result hit">{{localize 'ETERNIA.Combat.Hit'}}</span>
			{{else if (eq target.hit false)}}<span class="lh-result miss">{{localize 'ETERNIA.Combat.Miss'}}</span>
			{{else}}<span class="lh-result pending">{{localize 'ETERNIA.Combat.Pending'}}</span>{{/if}}
		</li>
		{{/each}}
	</ol>
</div>
