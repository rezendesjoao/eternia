{{!-- CLASS (module/classes/sheet.mjs): the crest with the base, the Motor (state, points, the Perfect Cut), the kit,
     the talents by branch, the Path (CR 3), the Apex (CR 10), the general talents, the Dedications and the milestones.
     Without a class: the button that opens the class browser. --}}
{{#*inline "lhclRow"}}
<li class="item lhcl-skill{{#if r.owned}} owned{{else}}{{#if r.locked}} locked{{/if}}{{/if}}"{{#if r.id}} data-item-id="{{r.id}}"{{/if}}>
	{{#if r.owned}}<a class="lhcl-skill-img" data-action="item-throw" data-tooltip="{{localize 'ETERNIA.Sheet.Use'}}"><img src="{{r.img}}" alt=""><i class="fa-solid fa-comment"></i></a>
	{{else}}<span class="lhcl-skill-img"><img src="{{r.img}}" alt=""></span>{{/if}}
	<span class="lhcl-skill-body">
		<a class="lhcl-skill-name" {{#if r.owned}}data-action="item-edit"{{else}}data-action="lhcl" data-op="open" data-uuid="{{r.uuid}}"{{/if}}>{{r.name}}</a>
		<span class="lhcl-skill-meta">
			{{#if r.kind}}<span class="lhcl-kind {{r.kind}}"><i class="{{r.kindIcon}}"></i> {{r.kindLabel}}</span>{{/if}}
			{{#if r.timing}}<span>{{r.timing}}</span>{{/if}}
			{{#if r.sr}}<span>{{localize "ETERNIA.Sheet.SRShort"}} {{r.sr}}</span>{{/if}}
			{{#if r.dedication}}<span class="lhcl-dedication-tag">{{localize "ETERNIA.Classes.DedicationTag"}}</span>{{/if}}
		</span>
	</span>
	<span class="lhcl-skill-state">{{#if r.owned}}<i class="fa-solid fa-check" data-tooltip="{{localize 'ETERNIA.Classes.Owned'}}"></i>{{else}}<span class="lhcl-rank">{{localize "ETERNIA.Classes.FromRank" n=r.minRank}}</span>{{/if}}</span>
</li>
{{/inline}}
{{#*inline "lhclMotor"}}
<div class="lhcl-motor {{m.state}}{{#if m.ready}} ready{{/if}}{{#if m.lesser}} lesser{{/if}}" data-motor="{{m.id}}">
	<div class="lhcl-motor-body">
		<header>
			<span class="lhcl-eyebrow">{{#if m.lesser}}{{localize "ETERNIA.Classes.LesserMotor"}}{{else}}{{localize "ETERNIA.Classes.Motor"}}{{/if}}</span>
			<h3>{{m.name}}</h3>
			{{#if m.hasStates}}
			{{#if m.editable}}<a class="lhcl-state" data-action="lhcl" data-op="state" data-tooltip="{{localize 'ETERNIA.Classes.StateTip' state=m.nextState}}">{{m.stateLabel}}</a>
			{{else}}<span class="lhcl-state">{{m.stateLabel}}</span>{{/if}}
			{{/if}}
		</header>
		<div class="lhcl-points">
			<span class="lhcl-pips">
				{{#each m.pips as |pip|}}<a class="lhcl-pip{{#if pip.on}} on{{/if}}"{{#if m.editable}} data-action="lhcl" data-op="pip" data-value="{{pip.value}}"{{/if}}></a>{{/each}}
			</span>
			<span class="lhcl-count"><b>{{m.value}}</b>/{{m.max}} {{m.unit}}</span>
			{{#if m.ready}}<span class="lhcl-ready"><i class="fa-solid fa-star"></i> {{m.readyLabel}}</span>{{/if}}
			{{#if m.note}}<span class="lhcl-note">{{m.note}}</span>{{/if}}
		</div>
		<dl class="lhcl-card">
			{{#each m.card as |row|}}<dt>{{row.label}}</dt><dd>{{row.text}}</dd>{{/each}}
		</dl>
	</div>
</div>
{{/inline}}
<section class="tab major class" data-group="primary" data-tab="class">
	<div class="tab-content">
	{{#with lh.classTab as |c|}}
	{{#if c.none}}

		<div class="lhcl-choose">
			<i class="fa-solid fa-chess-knight"></i>
			<h2>{{localize "ETERNIA.Classes.ChooseTitle"}}</h2>
			<p>{{localize "ETERNIA.Classes.ChooseHint"}}</p>
			{{#if c.editable}}<button type="button" data-action="class-img"><i class="fa-solid fa-book-atlas"></i> {{localize "ETERNIA.Classes.Choose"}}</button>{{/if}}
		</div>
		{{#each c.dedications as |m|}}{{> lhclMotor m=m}}{{/each}}

	{{else}}

		{{!-- Crest: the class and its base --}}
		<div class="lhcl-crest" style="--lhcl-color: {{c.color}}">
			<a class="lhcl-medallion" data-action="class-img" data-tooltip="{{localize 'ETERNIA.Classes.OpenClass'}}" aria-label="{{c.name}}"></a>
			<div class="lhcl-crest-body">
				<span class="lhcl-eyebrow">{{localize "ETERNIA.Classes.Eyebrow"}}</span>
				<h2 class="lhcl-name">{{c.name}}</h2>
				{{#if c.roles.length}}<span class="lhcl-roles">{{#each c.roles}}<span class="lhcl-role">{{this}}</span>{{/each}}</span>{{/if}}
			</div>
			<ul class="lhcl-base">
				{{#each c.base as |b|}}<li><b>{{b.value}}</b><span>{{b.label}}</span></li>{{/each}}
				<li class="hp" data-tooltip="{{c.hp.band}}"><b>{{c.hp.start}}</b><span>{{localize "ETERNIA.Classes.HpPer" n=c.hp.per}}</span></li>
			</ul>
		</div>

		{{!-- The Motor --}}
		{{#if c.motor}}{{> lhclMotor m=c.motor}}{{/if}}

		{{!-- Kit --}}
		{{#if c.kit.length}}
		<div class="subsection lhcl-group" style="--lhcl-color: {{c.color}}">
			<header><span>{{localize "ETERNIA.Classes.Kit"}}</span>{{#if c.editable}}<a class="lhcl-browse" data-action="lhcl" data-op="browse" data-tooltip="{{localize 'ETERNIA.SkillBrowser.Open'}}"><i class="fa-solid fa-book-open-reader"></i> {{localize "ETERNIA.SkillBrowser.Browse"}}</a>{{/if}}</header>
			<ol class="lhcl-skills">{{#each c.kit as |r|}}{{> lhclRow r=r}}{{/each}}</ol>
		</div>
		{{/if}}

		{{!-- Talents by branch --}}
		{{#each c.branches as |b|}}
		<div class="subsection lhcl-group" style="--lhcl-color: {{c.color}}">
			<header><span>{{b.label}}</span></header>
			<ol class="lhcl-skills">{{#each b.talents as |r|}}{{> lhclRow r=r}}{{else}}<li class="lhpf-empty">{{localize "ETERNIA.Classes.NoTalents"}}</li>{{/each}}</ol>
		</div>
		{{/each}}

		{{!-- Path --}}
		{{#if (or c.path.chosen c.path.options.length)}}
		<div class="subsection lhcl-group lhcl-path-group" style="--lhcl-color: {{c.color}}">
			<header><span>{{localize "ETERNIA.Classes.Path"}}</span><span class="lhcl-header-note">{{localize "ETERNIA.Classes.FromRank" n=3}}</span>
				{{#if c.path.pending}}{{#if c.editable}}<a class="lhcl-browse attention" data-action="lhcl" data-op="grants"><i class="fa-solid fa-route"></i> {{localize "ETERNIA.Classes.ChoosePath"}}</a>{{/if}}{{/if}}
			</header>
			{{#if c.path.chosen}}
			<div class="lhcl-path chosen">
				<ol class="lhcl-skills">{{> lhclRow r=c.path.chosen}}{{#each c.path.chosen.talents as |r|}}{{> lhclRow r=r}}{{/each}}</ol>
			</div>
			{{else}}
			<ul class="lhcl-paths">
				{{#each c.path.options as |p|}}
				<li class="lhcl-path-option">
					<a data-action="lhcl" data-op="open" data-uuid="{{p.uuid}}"><img src="{{p.img}}" alt=""><span>{{p.name}}</span></a>
				</li>
				{{/each}}
			</ul>
			{{/if}}
		</div>
		{{/if}}

		{{!-- Apex --}}
		{{#if c.apex}}
		<div class="subsection lhcl-group" style="--lhcl-color: {{c.color}}">
			<header><span>{{localize "ETERNIA.Classes.Apex"}}</span><span class="lhcl-header-note">{{localize "ETERNIA.Classes.FromRank" n=10}}</span></header>
			<ol class="lhcl-skills">{{> lhclRow r=c.apex}}</ol>
		</div>
		{{/if}}

		{{!-- General talents --}}
		{{#if c.general.length}}
		<div class="subsection lhcl-group" style="--lhcl-color: {{c.color}}">
			<header><span>{{localize "ETERNIA.Classes.General"}}</span></header>
			<ol class="lhcl-skills">{{#each c.general as |r|}}{{> lhclRow r=r}}{{/each}}</ol>
		</div>
		{{/if}}

		{{!-- Dedications: the Lesser Motors of other classes --}}
		{{#if c.dedications.length}}
		<div class="subsection lhcl-group" style="--lhcl-color: {{c.color}}">
			<header><span>{{localize "ETERNIA.Classes.Dedications"}}</span></header>
			{{#each c.dedications as |m|}}{{> lhclMotor m=m}}{{/each}}
		</div>
		{{/if}}

		{{!-- Milestones --}}
		<div class="subsection lhcl-ladder" style="--lhcl-color: {{c.color}}">
			<header><span>{{localize "ETERNIA.Classes.Milestones"}}</span></header>
			<ol>
				{{#each c.ladder as |r|}}
				<li class="{{#if r.reached}}reached{{/if}}{{#if r.current}} current{{/if}}"><span class="lhcl-step"><b>{{r.rank}}</b></span><span>{{r.label}}</span></li>
				{{/each}}
			</ol>
		</div>

	{{/if}}
	{{/with}}
	</div>
</section>
