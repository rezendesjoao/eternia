{{!-- CHARACTER: the portrait with what the character is (race, class and profession, each a card with one line
     about it; a blank character gets the creation wizard), the four attributes with the checks each one gives (a
     click rolls) and the tags. The connections and unions are in the bio. --}}
<section class="tab major character" data-group="primary" data-tab="character">
	<div class="tab-content">

		{{#if lh.creation.blank}}{{#if lh.creation.can}}
		<section class="lhpf-create">
			<span class="lhpf-create-medal"><i class="fa-solid fa-feather-pointed"></i></span>
			<div class="lhpf-create-text">
				<span class="lhpf-eyebrow">{{localize "ETERNIA.Sheet.Create.Eyebrow"}}</span>
				<h2>{{localize "ETERNIA.Sheet.Create.Title"}}</h2>
				<p>{{localize "ETERNIA.Sheet.Create.Lead"}}</p>
			</div>
			<button type="button" data-action="lhpf-wizard"><i class="fa-solid fa-wand-magic-sparkles"></i>{{localize "ETERNIA.Sheet.Create.Button"}}</button>
		</section>
		{{/if}}{{/if}}

		<div class="lhpf-identity">
			<div class="image-container{{#if lh.portrait}} token{{/if}}"{{#if lh.portrait}} style="{{lh.portrait.style}}"{{/if}}>
				<img class="actor-image" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
			</div>
			<ul class="lhpf-option-cards">
				{{#each lh.options as |o|}}
				<li class="lhpf-option-card {{o.type}}{{#unless o.item}} empty{{/unless}}{{#if o.form}} has-form{{/if}}" style="--opt-color: {{o.color}}">
					<span class="lhpf-option-art{{#if o.emblem}}{{#if o.item}} emblem{{/if}}{{/if}}">
						{{#if o.item}}<a data-action="{{#if o.emblem}}class-img{{else}}lhpf-open-item{{/if}}" data-item-id="{{o.item._id}}"><img src="{{o.img}}" alt=""></a>
						{{else}}<i class="fa-solid {{#if (eq o.type 'race')}}fa-people-group{{else if (eq o.type 'class')}}fa-chess-knight{{else}}fa-hammer{{/if}}"></i>{{/if}}
					</span>
					<div class="lhpf-option-body">
						<span class="lhpf-option-label">{{o.label}}</span>
						{{> "systems/eternia/templates/actor/parts/actor-option.html" type=o.type option=o.item placeholder=o.placeholder}}
						<span class="lhpf-option-line">{{#if o.icon}}<i class="{{o.icon}}"></i> {{/if}}{{o.line}}</span>
					</div>
					{{#if o.form}}
					<button type="button" class="lhpf-form-seal{{#if o.form.ready}} ready{{/if}}" {{#if o.form.can}}data-action="lhpf-evolve"{{else}}disabled{{/if}}
						data-tooltip="{{o.form.tip}}" aria-label="{{o.form.tip}}">
						<small>{{localize "ETERNIA.Evolve.Seal"}}</small><b>{{o.form.roman}}</b>{{#if o.form.ready}}<i class="fa-solid fa-paw"></i>{{/if}}
					</button>
					{{/if}}
				</li>
				{{/each}}
			</ul>
		</div>

		<section class="lhpf-attrs">
			<header class="lhpf-section">
				<span>{{localize 'ETERNIA.Sheet.AttributesChecks'}}</span>
				{{#if editable}}<button type="button" data-action="lhauto-allocate"><i class="fa-solid fa-fw fa-pen-to-square"></i>{{localize 'ETERNIA.Sheet.Allocate'}}</button>{{/if}}
			</header>
			<div class="lhpf-attr-grid">
				{{#each lh.attributes}}
				<div class="lhpf-attr" data-attribute="{{key}}">
					<span class="lhpf-attr-name"><b>{{label}}</b><small>{{abbr}} {{base}}</small></span>
					<span class="lhpf-attr-mod" data-tooltip="{{localize 'ETERNIA.Sheet.AttrTip' name=label total=base}}">{{modLabel}}</span>
					<ul class="lhpf-attr-checks">
						{{#each checks}}
						<li data-action="roll-check" data-name="{{name}}" data-dice="{{dice}}" data-bonus="{{total}}" data-tooltip="{{localize 'ETERNIA.ButtonLabel.Roll'}}: {{dice}}d6{{mod}}">
							<i class="fa-solid fa-dice-d6"></i>
							<span class="name">{{label}}</span>
							<span class="lhpf-dice" data-tier="{{tier}}">{{dice}}d6</span>
							<b class="modifier">{{mod}}</b>
						</li>
						{{/each}}
					</ul>
				</div>
				{{/each}}
			</div>
		</section>

		<div class="subsection lhpf-tagbox">
			<header><span>{{localize 'ETERNIA.Label.Tags'}}</span></header>
			{{> "systems/eternia/templates/parts/tag-input.html"}}
		</div>
	</div>
</section>
