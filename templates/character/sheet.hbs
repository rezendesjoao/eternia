{{!-- Parchment character sheet (eternia), laid out like the Pathfinder 2e character sheet:
     sidebar banner, header with the name and what the character is, the tabs (each with its name and what waits in
     it), the content. Keeps every selector and data-action the system's sheet logic relies on
     (see module/sheets/character-sheet.mjs); the look is in css/sheet.css. --}}
<div class="lhpf-sheet">

	<aside class="lhpf-sidebar">
		<div class="sidebar">
			{{> "systems/eternia/templates/character/sidebar.hbs"}}
		</div>
	</aside>

	<header class="lhpf-header">
		<div class="char-details">
			<input class="char-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'ETERNIA.Placeholder.Name'}}" spellcheck="false">
			<div class="char-line">
				{{#if lh.identity.length}}
				<span class="char-identity">{{#each lh.identity}}<a data-action="lhpf-open-item" data-item-id="{{id}}" class="{{type}}">{{name}}</a>{{/each}}</span>
				{{else if lh.creation.can}}
				<a class="char-identity empty" data-action="lhpf-wizard"><i class="fa-solid fa-feather-pointed"></i>{{localize 'ETERNIA.Sheet.CreateHint'}}</a>
				{{/if}}
				<span class="dots">
					<span class="label">{{localize 'ETERNIA.Label.Fate'}}</span>
					<a class="pips" data-action="lhauto-fate" data-tooltip="{{lh.fate.tooltip}}">
						{{#each lh.fate.pips}}<i class="{{#if this}}fa-solid{{else}}fa-regular{{/if}} fa-star"></i>{{else}}<i class="fa-regular fa-star"></i>{{/each}}
					</a>
				</span>
			</div>
		</div>
		<div class="char-level">
			{{#if lh.creation.can}}
			<button type="button" class="rank-up wizard" data-action="lhpf-wizard" data-tooltip="{{localize 'ETERNIA.Sheet.Wizard'}}"><i class="fa-solid fa-feather-pointed"></i></button>
			{{/if}}
			{{!-- The XP of the NP (experience/level.mjs): the bar to the next NP; the GM gives or sets it with a click --}}
			<div class="char-xp{{#if lh.xp.max}} max{{/if}}{{#if lh.xp.boost}} boosted{{/if}}{{#if lh.xp.gm}} editable{{/if}}"{{#if lh.xp.gm}} data-action="lhpf-xp"{{/if}} data-tooltip-html="{{lh.xp.tooltip}}" data-tooltip-class="lhb-tooltip">
				<span class="xp-line"><b>{{localize 'ETERNIA.Xp.Bar.Label'}}</b><span>{{lh.xp.label}}</span>{{#if lh.xp.boost}}<i class="fa-solid fa-flask-vial"></i>{{/if}}</span>
				<span class="xp-bar"><i style="width: {{lh.xp.pct}}%"></i></span>
			</div>
			{{#if lh.xp.gm}}
			<button type="button" class="rank-up" data-action="rank-up" data-tooltip="ETERNIA.RankUp.Tooltip"><i class="fa-solid fa-angles-up"></i></button>
			{{/if}}
			<div class="level" data-tooltip="{{localize 'ETERNIA.Sheet.CR'}}{{#unless lh.xp.gm}} · {{localize 'ETERNIA.Xp.Bar.ByXp'}}{{/unless}}">
				<svg class="badge" viewBox="0 0 40 43" aria-hidden="true"><path d="M20 1.5 37.5 6.5V21.5C37.5 31.5 29.5 38 20 41.5 10.5 38 2.5 31.5 2.5 21.5V6.5Z"></path></svg>
				<label>{{localize 'ETERNIA.Sheet.CRShort'}}</label>
				<input type="text" name="system.infos.crank" value="{{source.infos.crank}}" data-dtype="Number" maxlength="3"{{#unless lh.xp.gm}} readonly{{/unless}}{{#if modified.crank}} class="has-effect" data-tooltip="{{modified.crank.tooltip}}"{{/if}}>
			</div>
		</div>
	</header>

	<nav class="lhpf-nav lhpf-tabs tabs" data-group="primary" aria-label="{{localize 'ETERNIA.Sheet.Label'}}">
		{{#each lh.tabs}}
		<a class="item lhpf-tab" data-action="tab" data-group="primary" data-tab="{{id}}" data-tooltip="{{label}}"><i class="{{icon}}"></i><span>{{label}}</span>{{#if badge}}<b class="lhpf-badge">{{badge}}</b>{{/if}}</a>
		{{/each}}
	</nav>

	<section class="lhpf-body">
		{{> "systems/eternia/templates/character/character.hbs"}}
		{{> "systems/eternia/templates/character/skills.hbs"}}
		{{> "systems/eternia/templates/character/race.hbs"}}
		{{> "systems/eternia/templates/character/class.hbs"}}
		{{> "systems/eternia/templates/character/magic.hbs"}}
		{{> "systems/eternia/templates/character/inventory.hbs"}}
		{{> "systems/eternia/templates/character/profession.hbs"}}
		{{> "systems/eternia/templates/character/effects.hbs"}}
		{{> "systems/eternia/templates/character/biography.hbs"}}
	</section>
</div>
