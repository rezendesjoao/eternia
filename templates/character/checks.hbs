{{!-- CHECKS: the ability checks by attribute and the combat checks, each row rolls. --}}
<section class="tab major proficiencies" data-group="primary" data-tab="checks">
	<div class="tab-content">
		<header>{{localize 'ETERNIA.Sheet.AbilityChecks'}}</header>
		<ul class="proficiencies-list">
			{{#each lh.checks}}
			<li data-action="roll-check" data-name="{{name}}" data-dice="{{dice}}" data-bonus="{{total}}" data-tooltip="{{localize 'ETERNIA.ButtonLabel.Roll'}}: {{dice}}d6{{mod}}">
				<span class="d6"><i class="fa-solid fa-dice-d6"></i></span>
				<span class="modifier">{{mod}}</span>
				<span class="name" title="{{label}}">{{label}}</span>
				<span class="attr">{{attr}}</span>
				<span class="lhpf-dice" data-tier="{{tier}}">{{dice}}d6</span>
			</li>
			{{/each}}
		</ul>

		<header>{{localize 'ETERNIA.Sheet.CombatChecks'}}</header>
		<ul class="proficiencies-list combat">
			{{#each lh.combatChecks}}
			<li data-action="roll-check" data-name="{{name}}" data-dice="{{dice}}" data-bonus="{{total}}" data-tooltip="{{localize 'ETERNIA.ButtonLabel.Roll'}}: {{dice}}d6{{mod}}">
				<span class="d6"><i class="fa-solid fa-dice-d6"></i></span>
				<span class="modifier">{{mod}}</span>
				<span class="name" title="{{label}}">{{label}}</span>
				<span class="lhpf-dice" data-tier="{{tier}}">{{dice}}d6</span>
			</li>
			{{/each}}
		</ul>

	</div>
</section>
