{{!-- KUDEN (house rule): the Core and its Resource, the Kuden Points, the pieces and
     the color gifts (module/kuden/pieces.mjs). The rows keep the system's item selectors, so using, editing and
     deleting work as in the skills tab. --}}
<section class="tab major kuden" data-group="primary" data-tab="kuden">
	<div class="tab-content">
	{{#with lh.kuden as |k|}}

		<div class="subsection lhk-core">
			<header><span>{{localize 'ETERNIA.Kuden.Piece.core'}}</span></header>
			{{#if k.core}}
			<ol class="directory-list lhpf-list">
				<li class="item skill" data-item-id="{{k.core.id}}">
					<div class="item-name">
						<a class="item-image framed" data-action="item-throw" data-tooltip="{{localize 'ETERNIA.Sheet.Use'}}"><img src="{{k.core.img}}" alt=""><i class="fa-solid fa-comment"></i></a>
						<h4 class="name"><a data-action="lhauto-summary">{{k.core.name}}</a></h4>
					</div>
					<ul class="tags meta">
						<li class="tag tag_transparent">{{k.core.subtype}}</li>
						{{#if k.core.tier}}<li class="tag tag_alt" data-tooltip="{{k.core.restriction}}">{{k.core.tier}}</li>{{/if}}
					</ul>
					<div class="item-controls">
						<a class="item-control" data-action="item-edit" data-tooltip="ETERNIA.ButtonLabel.Edit"><i class="fa-solid fa-fw fa-pen-to-square"></i></a>
						{{#if k.editable}}<a class="item-control" data-action="item-delete" data-tooltip="ETERNIA.ButtonLabel.Delete"><i class="fa-solid fa-fw fa-trash"></i></a>{{/if}}
					</div>
					<div class="item-summary" hidden></div>
				</li>
			</ol>
			{{else}}
			<p class="lhpf-empty">{{localize 'ETERNIA.Kuden.Sheet.NoCore'}}</p>
			{{#if k.editable}}<div class="lhpf-toolbar"><span></span><button type="button" data-action="kuden-create" data-piece="core"><i class="fa-solid fa-fw fa-plus"></i>{{localize 'ETERNIA.Kuden.Sheet.CreateCore'}}</button></div>{{/if}}
			{{/if}}
		</div>

		{{#if k.resource}}
		<div class="subsection lhk-resource">
			<header><span>{{k.resource.name}}</span><span class="lhk-source">{{k.resource.sourceLabel}}</span></header>
			<div class="lhk-meter">
				{{#if k.resource.canEdit}}<a class="lhk-step" data-action="kuden-resource" data-delta="-1" data-tooltip="{{localize 'ETERNIA.Kuden.Sheet.Less'}}"><i class="fa-solid fa-minus"></i></a>{{/if}}
				<span class="lhk-pips">
					{{#each k.resource.pips as |pip|}}
					{{#if k.resource.canEdit}}
					<a class="lhk-pip{{#if pip.on}} on{{/if}}" data-action="kuden-resource" data-value="{{pip.value}}"></a>
					{{else}}
					<span class="lhk-pip{{#if pip.on}} on{{/if}}"></span>
					{{/if}}
					{{/each}}
				</span>
				{{#if k.resource.canEdit}}<a class="lhk-step" data-action="kuden-resource" data-delta="1" data-tooltip="{{localize 'ETERNIA.Kuden.Sheet.More'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
				<span class="lhk-value">{{k.resource.value}}/{{k.resource.max}}</span>
			</div>
		</div>
		{{/if}}

		<div class="subsection lhk-ledger">
			<header><span>{{localize 'ETERNIA.Kuden.Ledger.Title'}}</span></header>
			<div class="lhk-points">
				<span><b>{{k.ledger.paid}}</b> {{localize 'ETERNIA.Kuden.Ledger.Paid'}}</span>
				<span><b>{{k.ledger.cost}}</b> {{localize 'ETERNIA.Kuden.Ledger.Cost'}}</span>
				<span><b>{{k.ledger.kept}}</b> {{localize 'ETERNIA.Kuden.Ledger.Kept'}}</span>
				<span class="lhk-pending">{{k.ledger.pending}}</span>
				{{#if k.ledger.canSettle}}<button type="button" data-action="kuden-settle" data-tooltip="{{localize 'ETERNIA.Kuden.Ledger.SettleHint'}}"><i class="fa-solid fa-scale-balanced"></i>{{localize 'ETERNIA.Kuden.Ledger.Settle'}}</button>{{/if}}
			</div>
			{{#each k.ledger.warnings as |warning|}}<p class="lhk-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{warning}}</p>{{/each}}
		</div>

		<ol class="directory-list lhpf-list lhk-pieces">
			{{#each k.groups as |group|}}
			<li class="action-header">
				<h3 data-tooltip="{{group.hint}}">{{group.label}}</h3>
				<span class="count">{{group.rows.length}}</span>
				{{#if k.editable}}<div class="item-controls"><a data-action="kuden-create" data-piece="{{group.piece}}" data-tooltip="{{group.hint}}"><i class="fa-solid fa-plus"></i> {{localize 'ETERNIA.Add'}}</a></div>{{/if}}
			</li>
			{{#each group.rows as |row|}}
			<li class="item skill draggable" data-item-id="{{row.id}}">
				<div class="item-name">
					<a class="item-image framed" data-action="item-throw" data-tooltip="{{localize 'ETERNIA.Sheet.Use'}}"><img src="{{row.img}}" alt=""><i class="fa-solid fa-comment"></i></a>
					<h4 class="name"><a data-action="lhauto-summary">{{row.name}}</a></h4>
				</div>
				<ul class="tags meta">
					{{#if row.technique}}
					<li class="tag tag_alt lhk-sr" data-tooltip="{{localize 'ETERNIA.Sheet.SR'}}">
						{{#if k.editable}}<a data-action="kuden-rank" data-delta="-1" data-tooltip="{{localize 'ETERNIA.Kuden.Sheet.Lower'}}"><i class="fa-solid fa-minus"></i></a>{{/if}}
						{{localize 'ETERNIA.Sheet.SRShort'}} {{row.sr}}
						{{#if k.editable}}<a data-action="kuden-rank" data-delta="1" data-tooltip="{{localize 'ETERNIA.Kuden.Sheet.Raise'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
					</li>
					{{/if}}
					<li class="tag lhk-pk{{#if row.unpaid}} unpaid{{/if}}" data-tooltip="{{localize 'ETERNIA.Kuden.Sheet.PaidTip' paid=row.paid cost=row.cost}}">{{row.cost}} PK</li>
					{{#if row.tier}}<li class="tag tag_secondary" data-tooltip="{{row.restriction}}">{{row.tier}}</li>{{/if}}
					<li class="tag tag_transparent">{{row.timing}}</li>
					{{#if row.limit}}<li class="tag tag_transparent">{{row.limit}}</li>{{/if}}
				</ul>
				<div class="item-controls">
					<a class="item-control" data-action="item-edit" data-tooltip="ETERNIA.ButtonLabel.Edit"><i class="fa-solid fa-fw fa-pen-to-square"></i></a>
					{{#if k.editable}}<a class="item-control" data-action="item-delete" data-tooltip="ETERNIA.ButtonLabel.Delete"><i class="fa-solid fa-fw fa-trash"></i></a>{{/if}}
				</div>
				<div class="item-summary" hidden></div>
			</li>
			{{else}}
			<li class="lhpf-empty">{{localize 'ETERNIA.Kuden.Sheet.NoPieces'}}</li>
			{{/each}}
			{{/each}}
		</ol>

		<div class="subsection lhk-color">
			<header><span>{{localize 'ETERNIA.Kuden.Sheet.Color'}}</span></header>
			<ul class="tags">
				{{#each k.color as |gift|}}
				<li class="tag tag_transparent">{{gift.text}}{{#if k.editable}} <a data-action="kuden-color-remove" data-index="{{gift.index}}" data-tooltip="{{localize 'ETERNIA.Kuden.Sheet.ColorRemove'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
				{{else}}
				<li class="lhpf-empty">{{localize 'ETERNIA.Kuden.Sheet.NoColor'}}</li>
				{{/each}}
			</ul>
			{{#if k.colorOver}}<p class="lhk-warning"><i class="fa-solid fa-circle-info"></i> {{localize 'ETERNIA.Kuden.Sheet.ColorOver'}}</p>{{/if}}
			{{#if k.editable}}
			<div class="lhk-color-add">
				<input type="text" class="lhk-color-input" placeholder="{{localize 'ETERNIA.Kuden.Sheet.ColorPlaceholder'}}">
				<button type="button" data-action="kuden-color-add"><i class="fa-solid fa-fw fa-plus"></i>{{localize 'ETERNIA.Add'}}</button>
			</div>
			{{/if}}
		</div>

		<p class="lhk-env"><i class="fa-solid fa-sun-cloud"></i> {{localize 'ETERNIA.Kuden.Sheet.Env'}}: {{k.env}}</p>

	{{/with}}
	</div>
</section>
