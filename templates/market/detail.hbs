{{!-- The page of the item chosen in the Market (module/market/market.mjs): its picture, name, kind, Item Rank and
     grade, the price (and a shop's stock and base price), what it gives, its tags, its whole text and where it comes
     from; below, what the user can do with it (the GM buys for a character, gives, puts in a shop; a player buys or
     sells at a shop's counter), with why a button is off. Before an item is chosen: how the window works. --}}
<section class="mk-detail">
	{{#if page}}
	<article class="mk-page" style="--mk-grade: {{page.gradeColor}}">
		<header class="mk-page-head">
			<span class="mk-page-img"><img src="{{page.img}}" alt="{{page.name}}"></span>
			<div class="mk-page-titles">
				<span class="mk-eyebrow">{{page.typeLabel}} · {{localize "ETERNIA.Item.Label.Rank"}} {{page.rank}}</span>
				<h3>{{page.name}}</h3>
				<div class="mk-badges">
					{{#if page.gradeLabel}}<span class="mk-badge grade">{{page.gradeLabel}}</span>{{/if}}
					{{#if page.blocked}}<span class="mk-badge off"><i class="fa-solid fa-ban"></i>{{localize "ETERNIA.Market.NotSold"}}</span>{{/if}}
					{{#if page.twoHanded}}<span class="mk-badge">{{localize "ETERNIA.Market.TwoHanded"}}</span>{{/if}}
				</div>
			</div>
		</header>
		<div class="mk-page-price">
			<span class="mk-coin"><i class="fa-solid fa-coins"></i></span>
			<div><small>{{#if selling}}{{localize "ETERNIA.Market.YouGet"}}{{else}}{{localize "ETERNIA.Piles.Price"}}{{/if}}</small><b>{{page.priceLabel}}{{#if page.price}}<em>{{localize "ETERNIA.Piles.Gold"}}</em>{{/if}}</b></div>
			{{#if page.basePriceLabel}}<span class="mk-base" data-tooltip="{{localize 'ETERNIA.Market.BasePriceHint'}}">{{localize "ETERNIA.Market.BasePrice" n=page.basePriceLabel}}</span>{{/if}}
			{{#if isShop}}{{#unless selling}}<span class="mk-stock-big{{#if page.soldOut}} out{{/if}}">{{#if page.soldOut}}{{localize "ETERNIA.Piles.SoldOut"}}{{else}}{{#if (eq page.stock -1)}}{{localize "ETERNIA.Market.StockInfinite"}}{{else}}{{localize "ETERNIA.Market.StockLeft" n=page.stock}}{{/if}}{{/if}}</span>{{/unless}}{{/if}}
		</div>
		{{#if page.parts.length}}
		<ul class="mk-stats">{{#each page.parts}}<li>{{this}}</li>{{/each}}</ul>
		{{/if}}
		{{#if page.tagChips.length}}
		<div class="mk-tags">{{#each page.tagChips}}<span class="mk-tag"{{#if tip}} data-tooltip="{{tip}}"{{/if}}>{{label}}</span>{{/each}}</div>
		{{/if}}
		<div class="mk-desc">{{#if page.description}}{{{page.description}}}{{else}}<p class="mk-no-text">{{localize "ETERNIA.Market.NoText"}}</p>{{/if}}</div>
		{{#if page.sourceLine}}<footer class="mk-source"><i class="fa-solid fa-book"></i>{{page.sourceLine}}</footer>{{/if}}
	</article>

	<div class="mk-actions">
		{{#if actions.reason}}<p class="mk-why"><i class="fa-solid fa-circle-info"></i><span>{{actions.reason}}</span></p>{{/if}}
		{{#if actions.quantity}}
		<div class="mk-qty">
			<span>{{localize "ETERNIA.Piles.Quantity"}}</span>
			<button type="button" data-action="quantity" data-step="-1" {{#unless actions.quantity.canLess}}disabled{{/unless}} aria-label="−1"><i class="fa-solid fa-minus"></i></button>
			<b>{{actions.quantity.value}}</b>
			<button type="button" data-action="quantity" data-step="1" {{#unless actions.quantity.canMore}}disabled{{/unless}} aria-label="+1"><i class="fa-solid fa-plus"></i></button>
			<small>{{localize "ETERNIA.Market.Max" n=actions.quantity.max}}</small>
		</div>
		{{/if}}
		{{#if actions.stock}}
		<label class="mk-stock-field"><span>{{localize "ETERNIA.Piles.Stock"}}</span><input type="text" name="stock" value="{{actions.stock.value}}" placeholder="∞" data-tooltip="{{localize 'ETERNIA.Piles.StockHint'}}"></label>
		{{/if}}
		<div class="mk-buttons">
			{{#if actions.buy}}<button type="button" class="mk-primary" data-action="buy" {{#if actions.buy.disabled}}disabled{{/if}}><i class="fa-solid fa-cart-shopping"></i><span>{{actions.buy.label}}</span><b><i class="fa-solid fa-coins"></i>{{actions.buy.cost}}</b></button>{{/if}}
			{{#if actions.sell}}<button type="button" class="mk-primary" data-action="sell" {{#if actions.sell.disabled}}disabled{{/if}}><i class="fa-solid fa-hand-holding-dollar"></i><span>{{actions.sell.label}}</span><b><i class="fa-solid fa-coins"></i>{{actions.sell.gain}}</b></button>{{/if}}
			{{#if actions.give}}<button type="button" class="mk-secondary" data-action="give" {{#if actions.give.disabled}}disabled{{/if}}><i class="fa-solid fa-gift"></i><span>{{actions.give.label}}</span></button>{{/if}}
			{{#if actions.put}}<button type="button" class="mk-secondary" data-action="putInShop" {{#if actions.put.disabled}}disabled{{/if}}><i class="fa-solid fa-store"></i><span>{{actions.put.label}}</span></button>{{/if}}
			{{#if actions.remove}}<button type="button" class="mk-secondary danger" data-action="removeWare"><i class="fa-solid fa-trash"></i><span>{{localize "ETERNIA.Market.Remove"}}</span></button>{{/if}}
			{{#if actions.sheet}}<button type="button" class="mk-link" data-action="openSheet"><i class="fa-solid fa-book-open"></i><span>{{localize "ETERNIA.Market.OpenSheet"}}</span></button>{{/if}}
		</div>
		{{#if isMarket}}{{#if isGM}}<p class="mk-drag-hint"><i class="fa-solid fa-hand-pointer"></i>{{localize "ETERNIA.Market.DragHint"}}</p>{{/if}}{{/if}}
	</div>
	{{else}}
	<div class="mk-page mk-guide">
		<span class="mk-guide-icon"><i class="{{guide.icon}}"></i></span>
		<h3>{{guide.title}}</h3>
		<ul>{{#each guide.lines}}<li>{{this}}</li>{{/each}}</ul>
	</div>
	{{/if}}
</section>
