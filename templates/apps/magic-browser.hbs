{{!-- The Magia browser (module/apps/magic-picker.mjs, MagicBrowser): the filters, a card for each Magia and, beside
     them, the page of the Magia under the pointer (or of the one selected; with none, the guide). The pages are drawn
     when first shown (templates/apps/magic-page.hbs). Used by the Magia picker and by the creation wizard. --}}
<nav class="mp-filters">
	<div class="mp-chips">
		<button type="button" class="mp-chip active" data-filter="category" data-value="">{{localize "ETERNIA.MagicPicker.All"}}<b>{{total}}</b></button>
		{{#each categories}}
		<button type="button" class="mp-chip cat" data-filter="category" data-value="{{id}}" style="--mp-cat: {{color}}" data-tooltip-text="{{hint}}"><i class="{{icon}}"></i>{{label}}<b>{{count}}</b></button>
		{{/each}}
	</div>
	<div class="mp-chips roles">
		{{#each roles}}
		<button type="button" class="mp-chip role" data-filter="role" data-value="{{id}}" data-tooltip-text="{{hint}}"><i class="{{icon}}"></i>{{label}}</button>
		{{/each}}
	</div>
</nav>

<div class="mp-main">
	<ol class="mp-grid" role="listbox" aria-label="{{localize 'ETERNIA.MagicPicker.Heading'}}">
		{{#each magias}}
		<li class="mp-card{{#if blocked}} blocked{{/if}}" role="option" tabindex="0" aria-selected="false" style="--mp-cat: {{categoryColor}}"
			data-uuid="{{uuid}}" data-name="{{name}}" data-category="{{category}}" data-roles="{{rolesKey}}" data-search="{{search}}">
			<span class="mp-card-art"><img src="{{img}}" alt="" loading="lazy"></span>
			<span class="mp-card-text">
				<span class="mp-card-cat"><i class="{{categoryIcon}}"></i>{{categoryLabel}}</span>
				<span class="mp-card-name">{{name}}</span>
				<span class="mp-card-tag">{{tagline}}</span>
			</span>
			<span class="mp-card-roles">{{#each cardRoles}}<i class="{{icon}}" data-tooltip-text="{{label}}"></i>{{/each}}</span>
			{{#if holderLabel}}<span class="mp-card-holders{{#if holderFull}} full{{/if}}" data-tooltip-text="{{holderTip}}"><i class="fa-solid {{#if exclusive}}fa-crown{{else}}fa-user{{/if}}"></i>{{holderLabel}}</span>{{/if}}
			{{#if owned}}<span class="mp-card-owned" data-tooltip-text="{{ownedTip}}"><i class="fa-solid fa-book"></i></span>{{/if}}
			<i class="mp-card-check fa-solid fa-check"></i>
		</li>
		{{/each}}
		{{#if awakenWaiting}}
		<li class="mp-empty aw-waiting"><i class="fa-solid fa-dice-d20"></i>{{localize "ETERNIA.Awakening.Waiting"}}</li>
		{{else}}
		<li class="mp-empty" hidden><i class="fa-solid fa-wand-sparkles"></i>{{localize "ETERNIA.MagicPicker.Empty"}}</li>
		{{/if}}
	</ol>

	<aside class="mp-detail">
		{{!-- With no Magia under the pointer nor selected: how the Magias work --}}
		<article class="mp-page mp-guide" data-uuid="guide">
			<header class="mp-page-head">
				<span class="mp-page-art"><i class="fa-solid fa-hat-wizard"></i></span>
				<div>
					<span class="mp-page-cat">{{localize "ETERNIA.MagicPicker.Guide.Eyebrow"}}</span>
					<h3>{{localize "ETERNIA.MagicPicker.Guide.Title"}}</h3>
				</div>
			</header>
			<ol class="mp-guide-steps">
				<li><i class="fa-solid fa-bookmark"></i><p>{{guideSlots}}</p></li>
				<li><i class="fa-solid fa-stairs"></i><p>{{localize "ETERNIA.MagicPicker.Guide.Ranks"}}</p></li>
				<li><i class="fa-solid fa-gear"></i><p>{{localize "ETERNIA.MagicPicker.Guide.Motor"}}</p></li>
			</ol>
			<h4>{{localize "ETERNIA.MagicPicker.Guide.Categories"}}</h4>
			<ul class="mp-legend">
				{{#each categories}}<li style="--mp-cat: {{color}}"><i class="{{icon}}"></i><p><b>{{label}}.</b> {{hint}}</p></li>{{/each}}
			</ul>
		</article>
		<div class="mp-pages"></div>
	</aside>
</div>
