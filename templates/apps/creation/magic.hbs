{{!-- MAGIA: the Magia browser (templates/apps/magic-browser.hbs) for the class's slot of CR 1, with the choice a Magia
     asks for under it (the Mandamentos' Decree). A player draws it instead (the Awakening, module/apps/awakening.mjs):
     the bar of the rolls over a browser with only the Magias rolled. The GM chooses from all of them and reads what the
     player rolled. A class whose first slot comes later says so. --}}
{{#if noSlot}}
<div class="wz-empty-step">
	<span class="wz-medal big plain"><i class="fa-solid fa-hat-wizard"></i></span>
	<h3>{{localize "ETERNIA.Wizard.Magic.NoSlotTitle" name=className}}</h3>
	<p>{{localize "ETERNIA.Wizard.Magic.NoSlot" name=className rank=firstRank}}</p>
	{{#if slots.length}}<ul class="wz-slot-ranks">{{#each slots}}<li><small>{{localize "ETERNIA.Sheet.CRShort"}}</small>{{rank}}</li>{{/each}}</ul>{{/if}}
</div>
{{else}}
<div class="magic-picker wz-magic{{#if awakening}} aw-mode{{/if}}" style="--mp-class: {{color}}">
	<div class="wz-magic-head">
		{{#if awakening}}
		<p>{{localize "ETERNIA.Wizard.Magic.AwakenLead" name=className}}</p>
		{{else}}
		<p>{{localize "ETERNIA.Wizard.Magic.Lead" name=className}}{{#if gmAwakening}}<span class="aw-gm"><i class="fa-solid fa-dice-d20"></i>{{gmAwakening.text}} <button type="button" data-action="awakenReset"><i class="fa-solid fa-rotate-left"></i>{{localize "ETERNIA.Awakening.GM.Reset"}}</button></span>{{/if}}</p>
		<label class="mp-search">
			<i class="fa-solid fa-magnifying-glass"></i>
			<input type="search" placeholder="{{localize 'ETERNIA.MagicPicker.Search'}}" autocomplete="off" spellcheck="false">
		</label>
		{{/if}}
	</div>
	{{#if awakening}}{{> "systems/eternia/templates/apps/awakening-bar.hbs"}}{{/if}}
	{{> (lookup . "magicBrowser")}}
	<div class="wz-decree" hidden></div>
</div>
{{/if}}
